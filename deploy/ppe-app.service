[Unit]
Description=Frontline PPE Scorecard (FastAPI)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/app
Environment="PATH=/opt/app/.venv/bin"
ExecStart=/opt/app/.venv/bin/uvicorn webapp:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target